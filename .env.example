# Copy this file to .env and paste your free key.
# Get one at: https://pixabay.com/api/docs/  (signup is free, ~2 minutes)
PIXABAY_KEY=your_pixabay_key_here

# Admin publisher (Vercel production environment)
ADMIN_PASSWORD=replace-with-a-strong-private-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
GITHUB_TOKEN=github-fine-grained-token-with-contents-write-on-this-repo
GITHUB_REPO=xl8saif/dardic-archive
GITHUB_BRANCH=main
