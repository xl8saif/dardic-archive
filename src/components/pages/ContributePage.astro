---
/**
 * Contribute — locale-aware "Publish with us" page with the file-upload form.
 * Rendered at:
 *   /contribute/          (English)
 *   /ar/contribute/       (العربية)
 *   /ur/contribute/       (اردو)
 */
import Base from '../../layouts/Base.astro';
import { CONTRIBUTE } from '../../data/contribute';
import { SITE, FIKRCD, LINKS } from '../../data/profile';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  langPath?: string;
}

const { locale, langPath = '' } = Astro.props;
const T = t(locale);
const upload = CONTRIBUTE.upload;
const uploadEnabled = upload.enabled;

const filesLabel = T.form_files
  .replace('{n}', String(upload.maxFiles))
  .replace('{mb}', String(upload.maxFileMb));
const focusNote = T.cont_focus_note.replace('{langs}', CONTRIBUTE.alsoAccepted.join(', '));

const title = `${T.cont_h1} — ${T.site_title}`;
const alternates = {
  en: '/contribute/',
  ar: '/ar/contribute/',
  ur: '/ur/contribute/',
};
---

<Base title={title} description={T.cont_mission} lang={locale} alternates={alternates}>
  <article>
    <header class="article-hero">
      <div class="container">
        <p class="crumb">
          <a href={`${langPath}/`}>{T.nav_home}</a> / <span>{T.cont_crumbs}</span>
        </p>
        <h1>{T.cont_h1}</h1>
        <div class="meta">
          <span>{T.cont_tag}</span>
        </div>
      </div>
    </header>

    <div class="prose">
      <div class="prose-inner">
        <p class="lede">{T.cont_mission}</p>

        <div class="notice">
          <strong>{T.cont_focus}</strong> {CONTRIBUTE.focus.join(' · ')} {focusNote}
        </div>

        <h2>{T.cont_what}</h2>
        <div class="content-types">
          {T.types.map((ty) => (
            <span class="content-type" style="flex-direction: column; align-items: flex-start; gap: 0.1rem;">
              <strong>{ty.t}</strong>
              <small class="data-note" style="font-style: normal;">{ty.n}</small>
            </span>
          ))}
        </div>

        <h2>{T.cont_how}</h2>
        <p class="data-note">{T.cont_how_note}</p>
        <ol style="line-height: 1.9;">
          {T.process.map((p) => <li><strong>{p.s}.</strong> {p.d}</li>)}
        </ol>

        <h2>{T.cont_standards}</h2>
        <ul>
          {T.standards_list.map((s) => <li>{s}</li>)}
        </ul>

        <h2>{T.cont_rights}</h2>
        <ul>
          {T.rights_list.map((s) => <li>{s}</li>)}
        </ul>

        <h2>{T.cont_channel}</h2>

        {uploadEnabled ? (
          <form id="submission-form" class="submission-form" novalidate>
            <div class="form-grid">
              <label>
                <span>{T.form_name} <em>*</em></span>
                <input name="name" type="text" required maxlength="200" autocomplete="name" />
              </label>
              <label>
                <span>{T.form_email} <em>*</em></span>
                <input name="email" type="email" required maxlength="200" autocomplete="email" />
              </label>
              <label>
                <span>{T.form_type}</span>
                <select name="workType">
                  {T.types.map((ty) => <option value={ty.t}>{ty.t}</option>)}
                  <option value="other">{T.form_other}</option>
                </select>
              </label>
              <label>
                <span>{T.form_lang}</span>
                <select name="language">
                  {CONTRIBUTE.focus.map((l) => <option value={l}>{l}</option>)}
                  {CONTRIBUTE.alsoAccepted.map((l) => <option value={l}>{l}</option>)}
                  <option value="other">{T.form_other}</option>
                </select>
              </label>
            </div>
            <label>
              <span>{T.form_about}</span>
              <textarea name="about" rows="4" maxlength="2000"
                placeholder={T.form_about_ph}></textarea>
            </label>
            <label>
              <span>{filesLabel}</span>
              <input name="files" type="file" multiple
                accept=".doc,.docx,.pdf,.txt,.md,.rtf,.odt,.jpg,.jpeg,.png,.zip" />
            </label>
            <label>
              <span>{T.form_challenge} <strong>kohistan</strong> <em>*</em></span>
              <input name="challenge" type="text" required autocomplete="off" />
            </label>
            <div class="form-note data-note">
              {T.form_privacy}
            </div>
            <button class="btn btn-primary" type="submit">{T.form_send}</button>
            <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
          </form>
        ) : (
          <div class="notice">
            <strong>{T.cont_coming}</strong> {T.cont_coming_note}
            <a href={LINKS.fikrcdSite} target="_blank" rel="noopener">{FIKRCD.abbrev}</a>.
          </div>
        )}

        <section class="admin-publisher" aria-labelledby="admin-publisher-title">
          <div class="admin-publisher-head">
            <div>
              <span class="magazine-kicker">EDITORIAL ADMIN</span>
              <h2 id="admin-publisher-title">Publish an article</h2>
              <p>Admin-only publishing. Publish under your own name or enter another author's name and role. The article is committed directly to the archive repository and will enter the live site through the normal deployment pipeline.</p>
            </div>
            <span class="admin-badge">ADMIN</span>
          </div>

          <form id="admin-login" class="admin-login">
            <label><span>Admin password</span><input name="password" type="password" autocomplete="current-password" required /></label>
            <button class="btn btn-primary" type="submit">Unlock publisher</button>
            <p id="admin-login-status" class="form-status" role="status"></p>
          </form>

          <form id="admin-publish" class="admin-publish" hidden>
            <div class="form-grid">
              <label><span>Article title <em>*</em></span><input name="title" required maxlength="180" /></label>
              <label><span>Publication date <em>*</em></span><input name="pubDate" type="date" value={new Date().toISOString().slice(0,10)} required /></label>
              <label><span>Author name <em>*</em></span><input name="authorName" required maxlength="160" value={SITE.author} /></label>
              <label><span>Author role</span><input name="authorRole" maxlength="100" value="Author" /></label>
              <label><span>Language</span><select name="lang"><option value="en">English</option><option value="ur">Urdu</option><option value="ar">Arabic</option><option value="mvy">Indus-Kohistani</option><option value="scl">Shina</option></select></label>
              <label><span>Category</span><input name="category" value="Research" /></label>
              <label><span>Publication</span><select name="publication"><option value="">General archive</option><option value="shari">Shari Online Magazine</option></select></label>
              <label><span>Edition</span><select name="edition"><option value="">Not an issue</option><option value="2026-q4">2026 Q4 — Issue 01</option><option value="2027-q1">2027 Q1 — Issue 02</option><option value="2027-q2">2027 Q2 — Issue 03</option><option value="2027-q3">2027 Q3 — Issue 04</option></select></label>
              <label><span>Issue number</span><input name="issueNumber" type="number" min="1" max="999" /></label>
              <label><span>Tags</span><input name="tags" placeholder="language, folklore, research" /></label>
              <label><span>Related languages</span><input name="relatedLanguages" placeholder="Indus-Kohistani, Urdu" /></label>
            </div>
            <label><span>Description</span><textarea name="description" rows="3" maxlength="500"></textarea></label>
            <label><span>Article body — Markdown <em>*</em></span><textarea name="content" rows="18" required placeholder="Write or paste the final article here..."></textarea></label>
            <div class="admin-actions"><button class="btn btn-primary" type="submit">Publish article</button><button class="btn btn-ghost" id="admin-lock" type="button">Lock</button></div>
            <p id="admin-publish-status" class="form-status" role="status" aria-live="polite"></p>
          </form>
        </section>

        <h2>{T.cont_where}</h2>
        <ul>
          {T.where.map((w, i) => (
            <li>
              <a href={['/articles/', '/research/indus-kohistani-resources/',
                        '/folklore/', '/archive/',
                        '/languages/indus-kohistani/'][i]}>{w.l}</a> — {w.d}
            </li>
          ))}
        </ul>

        <p class="data-note" style="margin-top: 1.6rem;">
          {T.cont_via}
        </p>
      </div>
    </div>
  </article>

  <script>
    const loginForm = document.getElementById('admin-login');
    const publisher = document.getElementById('admin-publish');
    const loginStatus = document.getElementById('admin-login-status');
    const publishStatus = document.getElementById('admin-publish-status');
    const sayAdmin = (el, msg, cls='') => { if (el) { el.textContent = msg; el.className = 'form-status ' + cls; } };

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const password = new FormData(loginForm).get('password');
      sayAdmin(loginStatus, 'Checking…');
      try {
        const r = await fetch('/api/admin/login', { method: 'POST', headers: {'content-type':'application/json'}, body: JSON.stringify({password}) });
        const out = await r.json();
        if (!r.ok) throw new Error(out.error || 'Login failed.');
        loginForm.hidden = true;
        if (publisher) publisher.hidden = false;
        sayAdmin(loginStatus, 'Publisher unlocked.', 'ok');
      } catch (err) { sayAdmin(loginStatus, err.message || 'Login failed.', 'err'); }
    });

    document.getElementById('admin-lock')?.addEventListener('click', async () => {
      await fetch('/api/admin/login', {method:'DELETE'});
      if (publisher) publisher.hidden = true;
      if (loginForm) loginForm.hidden = false;
      sayAdmin(loginStatus, 'Publisher locked.');
    });

    publisher?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const button = form.querySelector('button[type="submit"]');
      const data = Object.fromEntries(new FormData(form).entries());
      button.disabled = true;
      sayAdmin(publishStatus, 'Publishing…');
      try {
        const r = await fetch('/api/admin/publish', {method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});
        const out = await r.json();
        if (!r.ok) throw new Error(out.error || 'Publication failed.');
        sayAdmin(publishStatus, 'Published successfully. The article is now in the repository and will appear after deployment.', 'ok');
        form.reset();
      } catch (err) { sayAdmin(publishStatus, err.message || 'Publication failed.', 'err'); }
      finally { button.disabled = false; }
    });
  </script>

  {uploadEnabled && (
    <script define:vars={{
      endpoint: upload.endpoint,
      maxFiles: upload.maxFiles,
      maxFileMb: upload.maxFileMb,
      msgNeedfile: T.client.needfile,
      msgMany: T.client.many.replace('{n}', String(upload.maxFiles)),
      msgLarge: T.client.large,
      msgSending: T.client.sending,
      msgOk: T.client.ok,
      msgErr: T.client.err,
      msgNoEndpoint: T.client.noendpoint,
      mbLabel: String(upload.maxFileMb),
    }}>
      const form = document.getElementById('submission-form');
      const status = document.getElementById('form-status');
      const btn = form ? form.querySelector('button[type=submit]') : null;

      function say(msg, cls) {
        if (status) {
          status.textContent = msg;
          status.className = 'form-status ' + cls;
        }
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);

        const files = Array.from(data.getAll('files')).filter((f) => f && f.size > 0);
        if (files.length === 0) {
          say(msgNeedfile, 'err');
          return;
        }
        if (files.length > maxFiles) {
          say(msgMany, 'err');
          return;
        }
        for (const f of files) {
          if (f.size > maxFileMb * 1024 * 1024) {
            say(msgLarge.replace('{name}', f.name).replace('{mb}', mbLabel), 'err');
            return;
          }
        }

        btn.disabled = true;
        say(msgSending, '');

        // Receiver not deployed yet: endpoint is empty.
        if (!endpoint) {
          form.reset();
          say(msgNoEndpoint, 'err');
          btn.disabled = false;
          return;
        }

        // Apps Script endpoints don't return CORS headers for reading responses,
        // so we POST no-cors (multipart is a simple request — no preflight)
        // and treat a completed send as accepted.
        try {
          await fetch(endpoint, { method: 'POST', body: data, mode: 'no-cors' });
          form.reset();
          say(msgOk, 'ok');
        } catch {
          say(msgErr, 'err');
        } finally {
          btn.disabled = false;
        }
      });
    </script>
  )}
</Base>
