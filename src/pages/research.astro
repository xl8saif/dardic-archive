---
import Base from '../layouts/Base.astro';
import {
  WORK_LANGUAGES,
  DIALECTS,
  ORTHOGRAPHY,
  FIKRCD,
} from '../data/profile';

const kohistani = WORK_LANGUAGES.find((l) => l.code === 'mvb')!;
const shina = WORK_LANGUAGES.find((l) => l.code === 'scl')!;
---

<Base title="Research — Saif Ullah" description="Language documentation, endangered-language preservation and orthography work on Indus-Kohistani and Shina.">
  <section class="section">
    <div class="container">
      <h1 style="font-family: var(--font-latin);">Research</h1>
      <p class="lede">
        Documentation and preservation work on the Dardic languages of the Indus Kohistan,
        carried out through <a href="/fikrcd/">FiKR&CD</a> and independent fieldwork.
      </p>

      <h2 style="font-family: var(--font-latin);">Indus-Kohistani</h2>
      <p class="lede">
        <strong><a href="/research/indus-kohistani-resources/">Indus-Kohistani Translation &amp; Written Resources</a></strong>
        — a research archive of written-resource production: translation, literary and
        educational works, language/grammar resources, publication and orthographic work —
        expanding the language’s written and digital presence. Distinct from commercial
        translation work.
      </p>
      <p class="lede">{kohistani.summary}</p>
      <ul class="scope-list">
        {kohistani.scopes.map((s) => <li>{s}</li>)}
      </ul>

      <h2 style="font-family: var(--font-latin); margin-top: 2.4rem;">Shina</h2>
      <p class="lede">{shina.summary}</p>
      <ul class="scope-list">
        {shina.scopes.map((s) => <li>{s}</li>)}
      </ul>

      <h2 style="font-family: var(--font-latin); margin-top: 2.4rem;">Dialects & varieties</h2>
      <p class="lede">
        Fieldwork distinguishes the following varieties. Each needs its own documentation
        record; the notes here will be filled from verified field data.
      </p>
      <ul class="scope-list">
        {DIALECTS.map((d) => <li><strong>{d.name}</strong> — <span class="data-note">{d.note}</span></li>)}
      </ul>

      <h2 style="font-family: var(--font-latin); margin-top: 2.4rem;">
        Orthography: established characters
      </h2>
      <p class="lede">
        The writing system uses a set of additional Arabic-script letters, rendered here in
        Scheherazade New, a Unicode typeface that covers the extended characters.
      </p>
      <table class="char-table">
        <thead>
          <tr><th>Character</th><th>Unicode</th><th>Usage</th></tr>
        </thead>
        <tbody>
          {ORTHOGRAPHY.map((o) => (
            <tr>
              <td class="char-glyph" lang="mvb">{o.char}</td>
              <td><code>{o.codepoint}</code></td>
              <td class="data-note">{o.usage}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="data-note">
        Usage descriptions are deliberately left pending verification until confirmed against
        the established orthographic record and community practice.
      </p>
      <p>
        Typography used for Indus-Kohistani material: <strong>Scheherazade New</strong> and
        <strong>Noto Nastaliq Urdu</strong>, both Unicode-compatible Arabic-script faces.
      </p>
    </div>
  </section>
</Base>
