---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { SHARI, SHARI_ISSUES } from '../../../data/shari';

export function getStaticPaths() {
  return SHARI_ISSUES.map((issue) => ({ params: { edition: issue.edition }, props: { issue } }));
}
const { issue } = Astro.props;
const articles = (await getCollection('articles', ({ data }) => data.status === 'published' && data.publication === SHARI.slug && data.edition === issue.edition))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'PublicationIssue',
  name: 'Shari Online Magazine — ' + issue.title,
  datePublished: issue.startDate,
  isPartOf: { '@type': 'Periodical', name: 'Shari Online Magazine', frequency: 'P3M' },
});
---
<Base title={'Shari — ' + issue.title} description={issue.description} structuredData={structuredData}>
  <section class="magazine-issue-hero"><div class="container">
    <a class="issue-back" href="/publications/shari/">← Shari Online Magazine</a>
    <div class="magazine-kicker">SHARI · ONLINE MAGAZINE</div>
    <p class="issue-number-large">ISSUE {String(issue.number).padStart(2, '0')}</p>
    <h1>{issue.title}</h1><p class="issue-label">{issue.editionLabel}</p><p class="magazine-dek">{issue.description}</p>
  </div></section>
  <section class="section"><div class="container">
    <div class="section-head"><h2>Articles in this edition</h2><span>{articles.length} published</span></div>
    {articles.length > 0 ? <div class="card-grid">{articles.map((article) => <ArticleCard article={article} />)}</div> : (
      <div class="issue-empty">
        <span class="magazine-kicker">EDITORIAL DESK</span>
        <h2>Articles for this edition are not published yet.</h2>
        <p>This issue is reserved and ready for publication. Mark an article with <code>publication: shari</code>, <code>edition: {issue.edition}</code>, and <code>status: published</code> and it will appear here automatically.</p>
        <a class="btn btn-ghost" href="/contribute/">Publication workflow</a>
      </div>
    )}
  </div></section>
</Base>
