---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { LANGUAGES } from '../../../data/site';

export async function getStaticPaths() {
  return Object.keys(LANGUAGES).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const info = LANGUAGES[lang!] ?? { name: lang!, native: lang!, dir: 'ltr' as const };
const articles = (await getCollection('articles', ({ data }) => data.status === 'published' && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`Articles in ${info.name}`} lang={lang} description={`Research articles and columns in ${info.name}.`}>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Articles in {info.native}</h2>
        <a href="/articles/">← All articles</a>
      </div>

      {articles.length === 0 ? (
        <p class="empty">Nothing published in this language yet.</p>
      ) : (
        <div class="card-grid">
          {articles.map((a) => <ArticleCard article={a} />)}
        </div>
      )}
    </div>
  </section>
</Base>
