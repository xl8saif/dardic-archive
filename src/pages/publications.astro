---
import Base from '../layouts/Base.astro';
import { PUBLICATIONS, PUBLICATIONS_NOTE } from '../data/professional';
---

<Base title="Publications — Saif Ullah" description="Structured publication records with DOI links — verified entries only.">
  <section class="section">
    <div class="container" style="max-width: 820px;">
      <h1 style="font-family: var(--font-latin);">Publications</h1>
      <p class="lede">
        Research records, publication metadata and a permanent home for quarterly issues of Shari.
      </p>

      <section class="publication-feature">
        <div>
          <div class="magazine-kicker">QUARTERLY · DIGITAL PUBLICATION</div>
          <h2><span class="magazine-name">Shari</span> Online Magazine</h2>
          <p>
            A dedicated editorial layer inside the Dardic Archive for articles on
            Indus-Kohistani language, literature, culture, folklore, research,
            documentation and community knowledge.
          </p>
          <div class="publication-feature-meta">
            <span>Every 3 months</span><span>·</span><span>Permanent issue archive</span><span>·</span><span>Multilingual publishing</span>
          </div>
        </div>
        <a class="btn btn-primary" href="/publications/shari/">Open Shari</a>
      </section>

      <h2 style="font-family: var(--font-latin); margin-top:2.8rem;">Research publications</h2>

      {PUBLICATIONS.map((pub) => (
        <article class="card" style="margin: 1.4rem 0;">
          <div class="card-body">
            <h2 class="card-title" style="margin:0;">{pub.title}</h2>
            <p class="card-meta" style="margin:0.2rem 0 0.4rem;">
              {pub.type && <span>{pub.type}</span>}
              {pub.relatedLanguages && <span>{pub.relatedLanguages.join(' · ')}</span>}
              {pub.requiresVerification && <span class="reported-flag">details pending verification</span>}
            </p>
            <a class="doi-pill" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">
              DOI {pub.doi}
            </a>
          </div>
        </article>
      ))}

      <div class="notice">{PUBLICATIONS_NOTE}</div>
    </div>
  </section>
</Base>
